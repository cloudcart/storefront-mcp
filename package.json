{
  "name": "@cloudcart/storefront-mcp",
  "version": "0.3.0",
  "description": "MCP server for the CloudCart Storefront GraphQL API — helps AI assistants build storefronts and checkouts that work",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudcart/storefront-mcp.git"
  },
  "homepage": "https://github.com/cloudcart/storefront-mcp#readme",
  "bugs": {
    "url": "https://github.com/cloudcart/storefront-mcp/issues"
  },
  "keywords": [
    "cloudcart",
    "mcp",
    "graphql",
    "storefront",
    "nitrogen",
    "headless"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cloudcart-storefront-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "check-wiki-links": "tsx scripts/check-wiki-links.ts"
  },
  "files": [
    "dist",
    "data"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "graphql": "^16.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
